dArrow=none;dashed=1;strokeColor=#B03A2E;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="a16" target="a32"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#B03A2E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a22" target="a33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#B03A2E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a28" target="a34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a82" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#B03A2E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a29" target="a35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a83" value="L&#x27;infirmière n&#x27;a accès qu&#x27;au résumé de la consultation en cours — règle de confidentialité du centre." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=10;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="160" width="300" height="100" as="geometry"/></mxCell><mxCell id="a84" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#C9B458;exitX=0;exitY=0.5;entryX=1;entryY=0.02;" edge="1" parent="1" source="a83" target="a1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a85" value="Pour l&#x27;ophtalmologie, l&#x27;ORL et la stomatologie, le triage est allégé : statut et identité seulement, sans anamnèse ni examen clinique." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=10;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="700" width="300" height="120" as="geometry"/></mxCell><mxCell id="a86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#C9B458;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a85" target="a11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a87" value="Le carnet de santé individuel est le seul support de circulation de l&#x27;information entre les étapes. Le patient le transporte." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=10;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="1080" width="300" height="110" as="geometry"/></mxCell><mxCell id="a88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#C9B458;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a87" target="a16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a89" value="Règle absolue : dès qu&#x27;un doute ou une complexité apparaît, le dossier est immédiatement remis au Médecin Chef, seul décisionnaire." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=10;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="1300" width="300" height="120" as="geometry"/></mxCell><mxCell id="a90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#C9B458;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a89" target="a17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a91" value="Prise en charge complète réservée aux CDI et à leurs ayants droit. Pour les autres statuts : soins assurés, puis refacturation à la société employeuse ou à l&#x27;assurance." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=10;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="1870" width="300" height="140" as="geometry"/></mxCell><mxCell id="a92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeColor=#C9B458;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="a91" target="a22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a93" value="Le couloir « Supports papier » n&#x27;est pas un acteur : c&#x27;est le support. Il disparaît dans le système conçu." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="2530" width="900" height="20" as="geometry"/></mxCell><mxCell id="a94" value="Encadrés à bord épais : les cinq points de rupture que le nouveau système supprime." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontColor=#5A5A5A;" vertex="1" parent="1"><mxGeometry x="40" y="2556" width="900" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>