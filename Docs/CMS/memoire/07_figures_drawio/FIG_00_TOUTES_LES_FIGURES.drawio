        <mxCell id="e8" value="Attributions de la Section des Affaires Sociales&lt;br&gt;&lt;br&gt;▪ Évacuations sanitaires&lt;br&gt;▪ Remboursements de frais&lt;br&gt;▪ Accidents de travail&lt;br&gt;▪ Congés maladie et maternité" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#2E6579;fontColor=#1F4E5F;fontSize=14;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
