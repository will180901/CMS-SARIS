        </mxCell>
        <mxCell id="e10" value="Le Médecin Chef dirige le Service Médico-Social et gère le Centre Médico-Sanitaire.&lt;br&gt;&lt;br&gt;Cette double fonction est son principal point de tension : elle motive la délégation de tâches à des infirmiers formés.&lt;br&gt;&lt;br&gt;Le personnel n&#39;est affecté à aucun site. Il tourne entre Moutela et Nkayi selon un planning de permutation, et aucun système ne reliait les deux sites : la consolidation était manuelle.&#xa;&#xa;Le détail du pôle consultation — la composante générale d&#39;un côté, l&#39;ophtalmologie, l&#39;ORL et la stomatologie de l&#39;autre — vient du recueil de l&#39;existant. Seule la composante générale entre dans le périmètre du projet." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="280" height="425" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="Consultation et soins" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#BCDCE8;strokeColor=#2E6579;strokeWidth=3;fontColor=#1F4E5F;fontSize=14;fontStyle=1;spacing=6;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="340" y="430" width="370" height="164" as="geometry" />
        </mxCell>
