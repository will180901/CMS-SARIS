        <mxCell id="e41" connectable="0" parent="e40" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=18;fontColor=#1F4E5F;labelBackgroundColor=#FFFFFF;" value="Stockage relationnel" vertex="1">
          <mxGeometry relative="1" x="0.15" as="geometry">
            <mxPoint x="-100" y="6" as="offset"/>
