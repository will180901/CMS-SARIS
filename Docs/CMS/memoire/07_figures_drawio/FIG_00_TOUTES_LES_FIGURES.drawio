" y="1502"/></Array></mxGeometry></mxCell><mxCell id="k719" value="0,n" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=14;fontColor=#1F4E5F;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="l718"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="l720" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#9AA7AC;jettySize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="e147" target="v717"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2842" y="1456"/><mxPoint x="2842" y="1502"/></Array></mxGeometry></mxCell><mxCell id="k721" value="1,1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=14;fontColor=#1F4E5F;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="l720"><mxGeometry x="-0.62" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="n722" value="ATELIER — document de travail, hors mémoire. Ces deux planches ne sont pas des figures du mémoire et n&#x27;ont pas vocation à y entrer : elles servent à travailler le modèle avec le directeur de mémoire. La règle de lisibilité à 8 points sur A4 ne s&#x27;y applique pas — elles se lisent à l&#x27;écran ou s&#x27;impriment en grand format.

NOTATION MERISE. Un rectangle est une entité, identifiant souligné. Une ellipse est une association et porte son verbe à l&#x27;infinitif. La cardinalité s&#x27;écrit sur la patte, du côté de l&#x27;entité, sous la forme minimum,maximum. Un MCD ne comporte aucune clé étrangère : le lien est porté par l&#x27;association, et ne devient une colonne qu&#x27;au passage au modèle physique.

VERBE PROPOSÉ. Une ellipse grise en pointillés, dont le verbe est entre parenthèses, porte un verbe PROPOSÉ. Le mémoire n&#x27;en nomme que 38 sur 97 — 13 sur les planches 8.1a à 8.1c, 25 sur les planches de classes 7.1 à 7.5, mis à l&#x27;infinitif. Les 59 autres n&#x27;ont aucune source écrite et ne peuvent entrer dans le mémoire sans validation préalable.

ENTITÉ RAPPELÉE. Un rectangle gris en pointillés, nom et identifiant seuls, est une entité d&#x27;un autre module rappelée là où elle est utilisée ; elle est détaillée dans son propre cadre. C&#x27;est la convention des figures 8.1a à 8.1c du mémoire. Vingt-cinq rappels remplacent trente-deux traits qui auraient traversé toute la planche.

MÉTIER ET TECHNIQUE. Cadres bleus : les sept modules métier, 55 entités. Cadres ambrés en pointillés : les trois modules techniques et transverses, 33 entités — sécurité et audit, messagerie interne, synchronisation hors connexion. Les 29 classes du diagramme de classes du mémoire sont toutes du côté métier, et les 33 entités techniques expliquent à elles seules plus de la moitié des 59 entités écartées.

SIX ENTITÉS NE PORTENT AUCUNE ASSOCIATION : AlerteAnomalie, ParametreSysteme, SauvegardeSysteme, RapportGenere, AlerteTechnique, SyncState. Ce n&#x27;est pas un oubli de tracé — le schéma de données ne leur déclare aucune relation. Toutes les six sont techniques.

SOURCE ET DATE. 88 entités, 971 champs déclarés (777 colonnes et 194 champs de navigation), 97 associations, relevés dans le schéma de données du dépôt le 18 septembre 2026. Dernière migration du dépôt : 15 août 2026." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=18;fontSize=15;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="60" y="3854" width="1900" height="320" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="ATELIER — MCD détaillé" id="atelierMCD1"><mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="6215" pageHeight="6996" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f1" value="DOSSIER PATIENT — 13 entités · 13 associations internes · 6 vers une entité rappelée" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FAFC;strokeColor=#2E6579;fontColor=#1F4E5F;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="1640" height="2730" as="geometry"/></mxCell><mxCell id="f2" value="ACTEURS ADMINISTRATIFS — 12 entités · 10 associations internes · 3 vers une entité rappelée" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4FAFC;strokeColor=#2E6579;fontColor=#1F4E5F;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="2900" width="1640" height="1572" as="geometry"/></mxCell><mxCell id="f3" value="SÉCURITÉ &amp; AUDIT — 18 entités · 13 associations internes · 2 vers une entité rappelée" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF6EC;strokeColor=#A08A3C;fontColor=#6B5A1E;verticalAlign=top;align=left;spacingLeft=16;spacingTop=10;fontSize=20;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="60" y="4582" width="1640" height="1984" as="geometry"/></mxCell><mxCell id="f