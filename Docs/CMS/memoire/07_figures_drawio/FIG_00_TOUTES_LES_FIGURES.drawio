        <mxCell id="e61" connectable="0" parent="e60" style="edgeLabel;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;resizable=0;points=[];fontSize=14;fontColor=#1F4E5F;labelBackgroundColor=#FFFFFF;" value="compte rendu : appliqués / ignorés / conflits" vertex="1">
          <mxGeometry height="20" relative="1" width="280" as="geometry">
            <mxPoint x="-130" y="2" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e62" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2E6579;fontColor=#1F4E5F;fontSize=14;" value="">
          <mxGeometry relative="1" as="geometry">
