        <mxCell id="e89" connectable="0" parent="e86" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=14;fontColor=#1F4E5F;labelBackgroundColor=#FFFFFF;" value="0..*" vertex="1">
