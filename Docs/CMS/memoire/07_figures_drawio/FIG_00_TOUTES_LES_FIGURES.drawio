          <mxGeometry x="0.92" relative="1" as="geometry">
            <mxPoint x="0" y="-12" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e74" value="Patient est le pivot du package : c&amp;#x27;est la seule des cinq classes reliée à toutes les autres. C&amp;#x27;est aussi la seule à porter des opérations — elle figure au tableau 7.6 des machines à états, avec quatre états : actif, archivé, décédé, fusionné. Une visite exige un dossier actif.&lt;br&gt;Le losange plein marque une composition : IdentitePatient n&amp;#x27;existe pas sans son patient. Le mémoire l&amp;#x27;énonce au § 7.3 — le dossier patient est éclaté en entités satellites plutôt que réuni dans une table unique, ce qui permet d&amp;#x27;appliquer des droits différents à la partie administrative et à la partie médicale.&lt;br&gt;Deux rattachements distincts, et c&amp;#x27;est le point que la planche doit faire voir. Un patient est ayant droit d&amp;#x27;un assuré en contrat à durée indéterminée — le rattachement porte alors le type de lien familial — ou salarié d&amp;#x27;une société sous-traitante. Les deux cas ouvrent des droits différents, tableau 3.4. Les rattachements sont historisés : un lien qui change ne s&amp;#x27;écrase pas.&lt;br&gt;En pointillés : les classes d&amp;#x27;un autre package. Leurs liens ne portent que les multiplicités." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="830" width="730" height="280" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
