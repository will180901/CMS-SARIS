        <mxCell id="e35" value="accès fichier" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=14;fontColor=#1F4E5F;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e34">
          <mxGeometry x="0" relative="1" as="geometry">
            <mxPoint x="58" y="0" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e36" value="Le poste en mode autonome occupe à lui seul la hauteur des deux autres nœuds : il porte quatre artefacts là où ils en portent deux. C&amp;#x27;est le point de la planche — il héberge son propre serveur et sa propre base, et fonctionne sans réseau.&lt;br&gt;Le serveur embarqué n&amp;#x27;écoute que sur la boucle locale, 127.0.0.1 : aucune autre machine du réseau ne peut l&amp;#x27;interroger. Le seul lien du poste autonome vers l&amp;#x27;extérieur est la synchronisation, tracée en pointillés — elle est intermittente et reprend au retour du réseau.&lt;br&gt;Les trois liaisons HTTPS sont obligatoires en production : une liaison en clair ferait transiter jetons d&amp;#x27;authentification et données patient à découvert.&lt;br&gt;Cette planche décrit le déploiement logiciel. L&amp;#x27;infrastructure réseau du centre — équipements et liaison entre les deux sites — n&amp;#x27;y figure pas : sa source documentaire est absente." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="940" width="745" height="200" as="geometry"/>
        </mxCell>
      </root>
