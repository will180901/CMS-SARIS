        <mxCell id="e18" value="À la conception préliminaire, le modèle du métier est projeté sur l&amp;#x27;architecture technique. Les entités du domaine deviennent des modèles de données, les cas d&amp;#x27;utilisation des routes et des écrans, les règles métier des contrôles et des services." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="225" height="215" as="geometry"/>
        </mxCell>
        <mxCell id="e19" value="Dans notre projet, chaque itération a livré un module fonctionnel complet, de la base de données à l&amp;#x27;écran, plutôt qu&amp;#x27;une couche technique horizontale." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="525" y="300" width="225" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="e20" value="Source&lt;br&gt;ROQUES Pascal, VALLÉE Franck, UML 2 en action — De l&amp;#x27;analyse des besoins à la conception, Eyrolles, Paris, 2007." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontColor=#5A5A5A;" vertex="1" parent="1">
