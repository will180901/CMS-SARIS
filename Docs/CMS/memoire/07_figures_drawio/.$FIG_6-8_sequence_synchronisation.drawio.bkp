        <mxCell id="e63" value="mettreÀJourLeCurseur()" style="edgeLabel;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;resizable=0;points=[];fontSize=14;fontColor=#1F4E5F;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e62">
          <mxGeometry x="0" width="220" height="20" relative="1" as="geometry">
            <mxPoint x="118" y="0" as="offset"/>
