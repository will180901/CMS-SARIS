        </mxCell>
        <mxCell id="e64" value="Le battement et la notification portent des types différents : le poste ne synchronise que sur la notification. Sans cette distinction, il synchroniserait à chaque battement — ce qui reviendrait à une interrogation périodique." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="250" width="236" height="162" as="geometry"/>
        </mxCell>
        <mxCell id="e65" value="Jamais de blocage : aucun verrou distribué n&amp;#x27;étant possible entre machines hors ligne, un conflit est tranché puis journalisé." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="432" width="236" height="118" as="geometry"/>
        </mxCell>
        <mxCell id="e66" value="Diagramme de séquence système : les deux extrémités sont des systèmes — c&amp;#x27;est le seul cas du mémoire dont l&amp;#x27;acteur principal n&amp;#x27;est pas une personne. Deux scénarios du tableau 6.15 ne sont pas dessinés : le déclenchement manuel, et le serveur injoignable — le poste continue alors sur sa base locale. Statut : partiellement implémenté." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fontSize=14;fillColor=#FFFDF0;strokeColor=#C9B458;fontColor=#5C4B00;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="20" y="1072" width="730" height="92" as="geometry"/>
        </mxCell>
      </root>
