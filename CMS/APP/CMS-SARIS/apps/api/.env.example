DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cms_saris_dev?schema=public"

JWT_SECRET="your-secret-key-here"
# JWT_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN ne sont PAS lues par le code (aucun effet si
# définies). Les vraies durées de vie sont : jeton d'accès → paramètre système en base
# `auth.session_timeout_minutes` (modifiable depuis l'admin, défaut 480 min = 8h) ;
# jeton de rafraîchissement → constante REFRESH_TOKEN_TTL (7 j) dans security.service.ts.

# Clé de chiffrement at-rest des secrets TOTP (AES-256-GCM). Phrase longue et unique.
# Ne JAMAIS la modifier après enrôlement de 2FA (rend les secrets indéchiffrables).
TOTP_ENC_KEY="change-me-totp-encryption-key"

# (Optionnel) Clé de chiffrement de la MESSAGERIE interne (AES-256-GCM, at-rest).
# Si absente : repli automatique sur TOTP_ENC_KEY (suffisant en dev). En production,
# utiliser une clé dédiée. Rotation multi-clés possible :
#   MESSAGE_ENC_KEYS="1:phraseA,2:phraseB"  +  MESSAGE_ENC_KEY_CURRENT="2"
# ou via un fichier de secrets monté :       MESSAGE_ENC_KEYS_FILE="/run/secrets/msg_keys"
MESSAGE_ENC_KEY="change-me-message-encryption-key"

PORT=3000
# Interface d'écoute. Par défaut (non défini) : 0.0.0.0 (toutes interfaces) — en mode
# backend embarqué (desktop), le processus force 127.0.0.1 indépendamment de cette valeur.
HOST=0.0.0.0
NODE_ENV=development

# Frontend autorisé (CORS). Origine unique la plus simple à renseigner ; pour plusieurs
# origines (ex. plusieurs domaines de prod), utiliser CORS_ORIGINS (liste séparée par des
# virgules, prioritaire sur FRONTEND_URL si les deux sont définies). Dans tous les cas,
# l'origine du client de bureau (app://cms-saris) et localhost/127.0.0.1 (mode backend
# embarqué) sont toujours autorisés en plus, sans avoir à les lister ici.
FRONTEND_URL="http://localhost:5173"
# CORS_ORIGINS="https://cms-saris-web.onrender.com,https://autre-domaine.example"

# Confiance proxy — pour récupérer la VRAIE IP client derrière un reverse-proxy.
# Nombre de proxys en amont : "1" = un seul (nginx/traefik direct), "2" = ex. Cloudflare + nginx.
# "true" = faire confiance à tous (à éviter en prod), "false" = aucun (accès direct sans proxy).
# Par défaut (non défini) : 1.
TRUST_PROXY=1

# ─────────────────────────────────────────────────────────────────────────────────────
# Mode SQLite / backend embarqué (desktop autonome hors-ligne) — NE PAS renseigner pour
# un serveur central classique (PostgreSQL, ci-dessus). Ces variables sont normalement
# injectées automatiquement par le processus Electron au démarrage du backend local
# (apps/desktop/electron/backend.ts) ; documentées ici pour référence uniquement.
# ─────────────────────────────────────────────────────────────────────────────────────
# DATABASE_PROVIDER=sqlite               # bascule le PrismaService en mode SQLite local
# SQLITE_CLIENT_PATH=                    # chemin du client Prisma SQLite généré (requis si sqlite)
# POSTE_LOCAL_ID=                        # identifiant stable du poste (UUID généré une fois)
# POSTE_LIBELLE=                         # nom lisible du poste (défaut : nom de la machine)
# SITE_ID=                               # site assigné par le serveur central au login
# SERVER_URL=                            # URL du serveur central à synchroniser
# SERVER_SYNC_TOKEN=                     # jeton de synchro (ou SERVER_SYNC_TOKEN_FILE ci-dessous)
# SERVER_SYNC_TOKEN_FILE=                # fichier contenant le jeton, relu à chaque cycle (prioritaire)
# SYNC_PROBE_SEC=4                       # sondage de joignabilité du central (défaut 4s, min 2s)
# SYNC_SAFETY_SEC=300                    # filet de sécurité périodique (défaut 300s, min 60s)
# SYNC_HEARTBEAT_SEC=30                  # battement de vie du poste (défaut 30s, min 10s)
